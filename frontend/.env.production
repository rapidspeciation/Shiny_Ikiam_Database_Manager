# Production builds (vite build): photo contributions on Identificar, shown to signed-in team members only
# (lib/contribConfig.ts contribFor; the server checks the sign-in too). Tests run in mode "test" and do not read this file.
VITE_CONTRIB=1
# Production builds (vite build): Confirmar visual field-ID guide cards on /identificar/ (override with VITE_CONFIRM_VISUAL_CARDS=0).
VITE_CONFIRM_VISUAL_CARDS=1
