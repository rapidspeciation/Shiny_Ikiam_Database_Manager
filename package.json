{
  "name": "ithomiini-database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "node scripts/instructions-history.mjs && npm --prefix frontend run build",
    "test": "node scripts/test-server.mjs && npm --prefix frontend test",
    "check": "node scripts/check.mjs",
    "wikiloc": "node tools/wikiloc/fetch.mjs",
    "test:slow": "node scripts/test-slow.mjs",
    "test:nightly": "node scripts/test-slow.mjs && node scripts/test-server.mjs --isolated"
  }
}
