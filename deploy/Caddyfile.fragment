# The app's own sites (appended to /etc/caddy/Caddyfile).
ithomiini-ikiam.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8794
}

# T3 Code, with the app's bridge in its pages (server/t3bridge.mjs): page loads and the
# bridge script go to the app, which fetches the page from T3 and adds one script tag
# (it tells the Asistente tab which chat its T3 frame shows). T3's API, built files and
# websockets go straight to T3. While the app is down its page loads go to T3 too
# (lb_policy first, a failed dial remembered for fail_duration): T3 without the bridge,
# and the Asistente guesses the open chat as before.
t3.ithomiini-ikiam.com {
	# T3's built files carry a content hash in their names (a new T3 version, new names): kept by the
	# browser instead of asked again on every load (T3 sends no-cache). Deferred, so it replaces T3's header.
	header /assets/* {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}
	@page {
		method GET
		header Accept *text/html*
		not path /api/* /assets/* /__ithomiini/*
	}
	handle /__ithomiini/bridge.js {
		reverse_proxy 127.0.0.1:8794
	}
	handle @page {
		reverse_proxy 127.0.0.1:8794 127.0.0.1:3773 {
			lb_policy first
			lb_try_duration 2s
			fail_duration 10s
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3773
	}
}
