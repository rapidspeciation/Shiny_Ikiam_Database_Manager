APP_HOST=127.0.0.1
APP_PORT=8794
APP_BASE_PATH=/ithomiini
APP_ORIGIN=https://tbs-insect-gallery.duckdns.org
DATABASE_PATH=/home/ubuntu/ithomiini/shared/database.sqlite
ATTACHMENT_DIR=/home/ubuntu/ithomiini/shared/attachments
GOOGLE_CREDENTIALS_FILE=/home/ubuntu/.config/ithomiini/google.json
KNOWLEDGE_DIR=/home/ubuntu/ithomiini/shared/knowledge
SETUP_TOKEN=replace-with-private-random-value
SESSION_SECRET=replace-with-private-random-value
ITHOMIINI_AI_BASE_URL=https://openrouter.ai/api/v1
ITHOMIINI_AI_MODEL=deepseek/deepseek-v4.1-flash
ITHOMIINI_AI_API_KEY_FILE=/home/ubuntu/.config/ithomiini/openrouter-key
ITHOMIINI_AI_VISION_MODEL=google/gemini-2.5-flash-lite
ITHOMIINI_AI_TRANSCRIPTION_MODEL=google/gemini-2.5-flash-lite
