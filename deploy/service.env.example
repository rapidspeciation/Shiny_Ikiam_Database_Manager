APP_HOST=127.0.0.1
APP_PORT=8794
APP_BASE_PATH=/
APP_ORIGIN=https://ithomiini-ikiam.duckdns.org
DATABASE_PATH=/home/ubuntu/ithomiini/shared/database.sqlite
ATTACHMENT_DIR=/home/ubuntu/ithomiini/shared/attachments
GOOGLE_CREDENTIALS_FILE=/home/ubuntu/.config/ithomiini/google.json
KNOWLEDGE_DIR=/home/ubuntu/ithomiini/shared/knowledge
SETUP_TOKEN=replace-with-private-random-value
SESSION_SECRET=replace-with-private-random-value
# Shared with the Apps Script trigger in tools/apps-script (instant updates from Google Sheets).
SHEET_HOOK_SECRET=replace-with-private-random-value
ITHOMIINI_AI_BASE_URL=https://openrouter.ai/api/v1
ITHOMIINI_AI_MODEL=deepseek/deepseek-v4.1-flash
ITHOMIINI_AI_API_KEY_FILE=/home/ubuntu/.config/ithomiini/openrouter-key
ITHOMIINI_AI_VISION_MODEL=google/gemini-2.5-flash-lite
ITHOMIINI_AI_TRANSCRIPTION_MODEL=google/gemini-2.5-flash-lite
# Claude Code (logged in with a Claude subscription) answers in the assistant for these users only.
ITHOMIINI_CLAUDE_BIN=/home/ubuntu/.local/bin/claude
ITHOMIINI_CLAUDE_USERS=franz
ITHOMIINI_CLAUDE_MODEL=sonnet
ITHOMIINI_CLAUDE_CONFIG_DIR=/home/ubuntu/.claude
ITHOMIINI_CLAUDE_WORKSPACE=/home/ubuntu/ithomiini/shared/assistant-workspace
# Invitation emails are sent as the project Gmail account with gog (login and keyring in ~/.config/ithomiini/gog.env).
ITHOMIINI_GOG_BIN=/home/ubuntu/.local/bin/gog
APP_PUBLIC_URL=https://ithomiini-ikiam.duckdns.org
# Specimen photos of the Revisión tab, fetched from Drive and cached (default: photo-cache next to the database, 1024 MB).
# PHOTO_CACHE_DIR=/home/ubuntu/ithomiini/shared/photo-cache
# PHOTO_CACHE_MB=1024
